<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Pos.Core\Pos.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sqlite.Core + bundle_e_sqlcipher en lugar de Sqlite: usa el motor SQLCipher (BD cifrada). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- DPAPI: protege la clave de la BD con la cuenta de Windows -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
