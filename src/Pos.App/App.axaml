<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             xmlns:v="using:Pos.App.Views"
             x:Class="Pos.App.App"
             RequestedThemeVariant="Default">

  <!-- Cada ViewModel se muestra con su vista -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:FirstRunViewModel"><v:FirstRunView /></DataTemplate>
    <DataTemplate DataType="vm:LoginViewModel"><v:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:WorkspaceViewModel"><v:WorkspaceView /></DataTemplate>
    <DataTemplate DataType="vm:AdminPinPromptViewModel"><v:AdminPinPromptView /></DataTemplate>
    <DataTemplate DataType="vm:SalePageViewModel"><v:SalePageView /></DataTemplate>
    <DataTemplate DataType="vm:ProductsPageViewModel"><v:ProductsPageView /></DataTemplate>
    <DataTemplate DataType="vm:CategoriesPageViewModel"><v:CategoriesPageView /></DataTemplate>
    <DataTemplate DataType="vm:UsersPageViewModel"><v:UsersPageView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel"><v:SettingsPageView /></DataTemplate>
    <DataTemplate DataType="vm:PaymentViewModel"><v:PaymentView /></DataTemplate>
    <DataTemplate DataType="vm:QuickCreateViewModel"><v:QuickCreateView /></DataTemplate>
    <DataTemplate DataType="vm:GenericItemViewModel"><v:GenericItemView /></DataTemplate>
    <DataTemplate DataType="vm:PrintPromptViewModel"><v:PrintPromptView /></DataTemplate>
    <DataTemplate DataType="vm:InvoiceTicketViewModel"><v:InvoiceTicketView /></DataTemplate>
    <DataTemplate DataType="vm:TicketsPageViewModel"><v:TicketsPageView /></DataTemplate>
    <DataTemplate DataType="vm:BusinessPageViewModel"><v:BusinessPageView /></DataTemplate>
    <DataTemplate DataType="vm:PrinterPageViewModel"><v:PrinterPageView /></DataTemplate>
    <DataTemplate DataType="vm:CloseCashViewModel"><v:CloseCashView /></DataTemplate>
    <DataTemplate DataType="vm:LabelsPageViewModel"><v:LabelsPageView /></DataTemplate>
    <DataTemplate DataType="vm:DataPageViewModel"><v:DataPageView /></DataTemplate>
    <DataTemplate DataType="vm:VerifactuPageViewModel"><v:VerifactuPageView /></DataTemplate>
    <DataTemplate DataType="vm:AboutPageViewModel"><v:AboutPageView /></DataTemplate>
    <DataTemplate DataType="vm:DiscountViewModel"><v:DiscountView /></DataTemplate>
    <DataTemplate DataType="vm:ReturnDialogViewModel"><v:ReturnDialogView /></DataTemplate>
    <DataTemplate DataType="vm:ExchangeDialogViewModel"><v:ExchangeDialogView /></DataTemplate>
    <DataTemplate DataType="vm:AuditPageViewModel"><v:AuditPageView /></DataTemplate>
    <DataTemplate DataType="vm:VariantPickerViewModel"><v:VariantPickerView /></DataTemplate>
    <DataTemplate DataType="vm:PriceCheckViewModel"><v:PriceCheckView /></DataTemplate>
    <DataTemplate DataType="vm:PricesPageViewModel"><v:PricesPageView /></DataTemplate>
    <DataTemplate DataType="vm:SalesReportPageViewModel"><v:SalesReportPageView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="OkBrush" Color="#16A34A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Botones grandes para uso táctil -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="18" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- Mensajes de error / confirmación -->
    <Style Selector="Border.message">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="Background" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.message.error">
      <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.message TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Menú lateral -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Teclado de PIN -->
    <Style Selector="Button.key">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="72" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Ventanas emergentes (cobro, alta rápida…) -->
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="0 8 32 0 #60000000" />
    </Style>

    <!-- Selector de método de pago -->
    <Style Selector="Button.mode">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Button.mode.selected">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Descuadre de caja: falta dinero -->
    <Style Selector="TextBlock.short">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>

    <!-- Botones de categoría y producto en la venta -->
    <Style Selector="Button.tile">
      <Setter Property="Width" Value="160" />
      <Setter Property="Height" Value="88" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
