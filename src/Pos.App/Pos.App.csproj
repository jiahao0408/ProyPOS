<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StarSeaPOS</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Bindings compilados: un error en un binding de XAML falla al compilar, no en la tienda. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\starseapos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\starseapos.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pos.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pos.Core\Pos.Core.csproj" />
    <ProjectReference Include="..\Pos.Data\Pos.Data.csproj" />
    <ProjectReference Include="..\Pos.Localization\Pos.Localization.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Sales\Pos.Modules.Sales.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Products\Pos.Modules.Products.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Printing\Pos.Modules.Printing.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Invoicing\Pos.Modules.Invoicing.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.CashRegister\Pos.Modules.CashRegister.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Hardware\Pos.Modules.Hardware.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Users\Pos.Modules.Users.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Verifactu\Pos.Modules.Verifactu.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.DataTransfer\Pos.Modules.DataTransfer.csproj" />
    <ProjectReference Include="..\Modules\Pos.Modules.Bazaar\Pos.Modules.Bazaar.csproj" />
  </ItemGroup>

  <!-- Las traducciones se copian junto al ejecutable como ficheros sueltos: se pueden añadir sin recompilar. -->
  <ItemGroup>
    <!--
      Datos del productor (VFA-06). producer.json tiene los datos reales y NO se sube a git (NIF y dirección
      personales); si no existe, se copia la plantilla producer.example.json y la app avisa de que faltan datos.
    -->
    <None Include="producer.json" Condition="Exists('producer.json')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="producer.example.json" Condition="!Exists('producer.json')" Link="producer.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
