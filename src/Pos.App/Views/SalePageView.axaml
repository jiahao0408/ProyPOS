<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             x:Class="Pos.App.Views.SalePageView"
             x:DataType="vm:SalePageViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F12" Command="{Binding ChargeCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding CheckPriceCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseDialogCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <!-- CAJ-01: caja cerrada -->
    <StackPanel IsVisible="{Binding IsCashClosed}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Classes="title" Text="{Binding L[CashClosedTitle]}" />
      <TextBlock Text="{Binding L[CashClosedHint]}" TextWrapping="Wrap" FontSize="16" />
      <TextBlock Classes="label" Text="{Binding L[OpeningFloat]}" />
      <TextBox Text="{Binding OpeningFloatText}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding OpenCashCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Classes="primary" Margin="0,16,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{Binding L[OpenCash]}" Command="{Binding OpenCashCommand}" />
      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>
    </StackPanel>

    <!-- Caja abierta: catálogo a la izquierda, ticket a la derecha -->
    <Grid IsVisible="{Binding IsCashOpen}" ColumnDefinitions="*,16,440">

      <DockPanel Grid.Column="0">
        <!-- Buscador: aquí escribe el lector de códigos (HW-04) -->
        <TextBox DockPanel.Dock="Top" Name="SearchBox" FontSize="22" MinHeight="56"
                 Watermark="{Binding L[SaleSearchHint]}" Text="{Binding SearchText}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Text="{Binding CashInfo}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Focusable="False" MinHeight="36" FontSize="14" Padding="12,4"
                    Content="{Binding L[PriceCheckF9]}" Command="{Binding CheckPriceCommand}" />
            <Button Focusable="False" MinHeight="36" FontSize="14" Padding="12,4"
                    Content="{Binding L[CloseCash]}" Command="{Binding StartCloseCashCommand}" />
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
          <TextBlock Text="{Binding Message}" FontSize="18" />
        </Border>

        <!-- Categorías (PRE-02) -->
        <ItemsControl DockPanel.Dock="Top" Margin="0,12,0,0" ItemsSource="{Binding Categories}" IsVisible="{Binding !IsSearching}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryButton">
              <Button Classes="tile" Focusable="False" Height="64" Background="{Binding Background, TargetNullValue={StaticResource ButtonBackground}}"
                      Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).SelectCategoryCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Artículo genérico por sección (BAZ-02) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8"
                    IsVisible="{Binding !IsSearching}">
          <TextBlock Text="{Binding L[GenericItem]}" VerticalAlignment="Center" FontSize="15" Opacity="0.75" />
          <ItemsControl ItemsSource="{Binding GenericSections}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GenericButton">
                <Button Focusable="False" Margin="0,0,8,0" BorderThickness="3" BorderBrush="{Binding Background}"
                        Content="{Binding Section.Name}"
                        Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).AddGenericCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Productos (de la categoría o de la búsqueda) -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Products}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProductButton">
                <Button Classes="tile" Focusable="False" Height="96"
                        Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).AddProductCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" MaxHeight="40" />
                    <TextBlock Text="{Binding Price}" TextAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).L[ChooseVariant]}"
                               IsVisible="{Binding HasVariants}" TextAlignment="Center" FontSize="12" Opacity="0.7" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Ticket -->
      <Border Grid.Column="2" Padding="16" CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding L[Ticket]}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding ItemCountText}" VerticalAlignment="Center" Opacity="0.7" />
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding TicketDiscountText}" FontSize="14" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Focusable="False" MinHeight="36" FontSize="14" Padding="12,4"
                      Content="{Binding L[TicketDiscountButton]}" Command="{Binding EditTicketDiscountCommand}" IsEnabled="{Binding HasTicketLines}" />
            </Grid>
            <TextBlock Text="{Binding VatSummary}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding L[Total]}" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="32" FontWeight="Bold" />
            </Grid>
            <Grid ColumnDefinitions="Auto,8,*">
              <Button Content="{Binding L[ClearTicket]}" Command="{Binding ClearTicketCommand}" IsEnabled="{Binding HasTicketLines}" />
              <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      MinHeight="64" FontSize="24" Content="{Binding L[ChargeF12]}" Command="{Binding ChargeCommand}" />
            </Grid>
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding TicketLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TicketLineRow">
                  <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.ColumnSpan="7" Text="{Binding Description}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnitPrice}" FontSize="13" Opacity="0.7" />
                        <TextBlock Text="{Binding DiscountText}" FontSize="12" Foreground="{StaticResource OkBrush}"
                                   IsVisible="{Binding DiscountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <Button Grid.Row="1" Grid.Column="1" Focusable="False" Content="−" MinWidth="44" MinHeight="40" Padding="0"
                              HorizontalContentAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).DecreaseLineCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Quantity}" FontSize="18" MinWidth="36"
                                 TextAlignment="Center" VerticalAlignment="Center" />
                      <Button Grid.Row="1" Grid.Column="3" Focusable="False" Content="+" MinWidth="44" MinHeight="40" Padding="0"
                              HorizontalContentAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).IncreaseLineCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Total}" FontSize="18" MinWidth="90"
                                 TextAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                      <Button Grid.Row="1" Grid.Column="5" Focusable="False" Content="%" MinWidth="44" MinHeight="40" Padding="0" Margin="0,0,4,0"
                              HorizontalContentAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).EditLineDiscountCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Row="1" Grid.Column="6" Focusable="False" Content="✕" MinWidth="44" MinHeight="40" Padding="0"
                              HorizontalContentAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SalePageViewModel)DataContext).RemoveLineCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Ventanas: cobro, alta rápida, artículo genérico -->
    <Border IsVisible="{Binding IsDialogOpen}" Background="#80000000">
      <ContentControl Content="{Binding Dialog}" />
    </Border>
  </Grid>
</UserControl>
