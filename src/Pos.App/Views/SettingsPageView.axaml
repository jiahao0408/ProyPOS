<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             xmlns:loc="using:Pos.Core.Localization"
             x:Class="Pos.App.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Classes="title" Text="{Binding L[NavSettings]}" />

      <TextBlock Classes="label" Text="{Binding L[AppLanguage]}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="loc:LanguageInfo">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="label" Text="{Binding L[PrintLanguage]}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PrintLanguages}" SelectedItem="{Binding SelectedPrintLanguage}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="loc:LanguageInfo">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding L[PrintLanguageHint]}" TextWrapping="Wrap" FontSize="13" Opacity="0.7" Margin="0,4,0,0" />

      <!-- v1.1.5: modo de la pantalla de venta -->
      <TextBlock Classes="label" Text="{Binding L[SaleModeLabel]}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SaleModes}" SelectedItem="{Binding SaleMode}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IChoice"><TextBlock Text="{Binding Title}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="label" Text="{Binding L[CurrencySymbol]}" />
      <TextBox Text="{Binding CurrencySymbol}" MaxLength="5" />

      <TextBlock Classes="label" Text="{Binding L[DateFormat]}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DateFormats}" SelectedItem="{Binding SelectedDateFormat}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DateFormatOption">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="label" Text="{Binding L[InactivityMinutes]}" />
      <TextBox Text="{Binding InactivityMinutesText}" />

      <TextBlock Classes="label" Text="{Binding L[MaxCashierDiscount]}" />
      <TextBox Text="{Binding MaxCashierDiscountText}" />

      <TextBlock Classes="label" Text="{Binding L[UpdateFeedUrl]}" />
      <TextBox Text="{Binding UpdateFeedUrl}" />

      <TextBlock Classes="label" Text="{Binding L[Preview]}" />
      <TextBlock Text="{Binding Preview}" FontSize="18" />

      <!-- v1.1.5: atajos de teclado de la venta -->
      <TextBlock Text="{Binding L[ShortcutsTitle]}" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,0" />
      <TextBlock Text="{Binding L[ShortcutsSettingsHint]}" TextWrapping="Wrap" FontSize="13" Opacity="0.7" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding ShortcutRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShortcutRowViewModel">
            <Grid ColumnDefinitions="*,8,200" Margin="0,3">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBox Grid.Column="2" Text="{Binding Keys}" FontFamily="Consolas, monospace" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Margin="0,8,0,0" Content="{Binding L[ShortcutsReset]}" Command="{Binding ResetShortcutsCommand}" />

      <Button Classes="primary" Margin="0,20,0,0" Content="{Binding L[Save]}" Command="{Binding SaveCommand}" />

      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>

      <TextBlock Classes="label" Margin="0,32,0,4" Text="{Binding L[ModulesLoaded]}" />
      <ItemsControl ItemsSource="{Binding ModuleNames}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" FontSize="15" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
