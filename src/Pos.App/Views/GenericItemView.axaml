<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             x:Class="Pos.App.Views.GenericItemView"
             x:DataType="vm:GenericItemViewModel">
  <Border Classes="dialog" Width="420">
    <StackPanel>
      <TextBlock Text="{Binding L[GenericItem]}" FontSize="15" Opacity="0.75" />
      <TextBlock Text="{Binding SectionName}" FontSize="24" FontWeight="SemiBold" />

      <TextBlock Classes="label" Text="{Binding L[Amount]}" />
      <TextBox Name="AmountBox" Text="{Binding AmountText}" FontSize="28">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <Grid ColumnDefinitions="Auto,8,*" Margin="0,16,0,0">
        <Button Content="{Binding L[Cancel]}" Command="{Binding CancelCommand}" />
        <Button Grid.Column="2" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{Binding L[AddToTicket]}" Command="{Binding AddCommand}" />
      </Grid>

      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
