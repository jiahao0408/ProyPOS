<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             x:Class="Pos.App.Views.VerifactuPageView"
             x:DataType="vm:VerifactuPageViewModel">
  <Grid ColumnDefinitions="460,24,*">
    <!-- VFA-01: certificado, entorno y conexión -->
    <ScrollViewer Grid.Column="0">
      <StackPanel>
        <TextBlock Classes="title" Text="{Binding L[NavVerifactu]}" />
        <TextBlock Text="{Binding L[VerifactuHint]}" TextWrapping="Wrap" Opacity="0.75" />

        <TextBlock Text="{Binding L[Certificate]}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock Text="{Binding CertificateInfo}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Classes="label" Text="{Binding L[CertificatePassword]}" />
        <TextBox Text="{Binding CertificatePassword}" PasswordChar="●" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="{Binding L[LoadCertificate]}" Click="OnLoadCertificate" />
          <Button Content="{Binding L[RemovePhoto]}" Command="{Binding RemoveCertificateCommand}" IsVisible="{Binding HasCertificate}" />
        </StackPanel>

        <TextBlock Classes="label" Text="{Binding L[VerifactuEnvironment]}" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:IChoice">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- VFA-04: modalidad -->
        <TextBlock Classes="label" Text="{Binding L[VerifactuModeLabel]}" />
        <RadioButton GroupName="VerifactuMode" Content="{Binding L[VerifactuModeVeriFactu]}" IsChecked="{Binding Enabled}" />
        <RadioButton GroupName="VerifactuMode" Content="{Binding L[VerifactuModeNoVeriFactu]}" IsChecked="{Binding IsNoVeriFactu}" />
        <TextBlock Text="{Binding L[VerifactuModeHint]}" TextWrapping="Wrap" FontSize="13" Opacity="0.7" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
          <Button Classes="primary" Content="{Binding L[Save]}" Command="{Binding SaveCommand}" />
          <Button Content="{Binding L[TestConnection]}" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
        <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- VFA-04: No VERI*FACTU: firmas y registro de eventos -->
        <TextBlock Text="{Binding L[VerifactuEventLog]}" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,0" />
        <TextBlock Text="{Binding SignatureSummary}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="{Binding L[VerifactuSignNow]}" Command="{Binding SignNowCommand}" />
          <Button Content="{Binding L[VerifactuVerifyEvents]}" Command="{Binding VerifyEventsCommand}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Events}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VerifactuEventRow">
              <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding When}" Foreground="Gray" /><Run Text="  " /><Run Text="{Binding Type}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Details}" /></TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- VFA-02/03: cola de envíos -->
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="{Binding L[VerifactuQueue]}" FontSize="20" FontWeight="SemiBold" Margin="0,48,0,0" />
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
        <TextBlock Text="{Binding QueueSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{Binding L[SendNow]}" Command="{Binding SendNowCommand}" IsEnabled="{Binding !IsBusy}" />
      </Grid>
      <!-- VFA-05: filtro por estado -->
      <ComboBox DockPanel.Dock="Top" MinWidth="240" Margin="0,0,0,8" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IChoice">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ListBox ItemsSource="{Binding Records}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VerifactuRow">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock><Run Text="{Binding Number}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Type}" /><Run Text="  " /><Run Text="{Binding Status}" /></TextBlock>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{StaticResource ErrorBrush}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" FontSize="13" Opacity="0.7" />
              </StackPanel>
              <Button Grid.Column="1" MinHeight="36" FontSize="13" Padding="8,2" VerticalAlignment="Center"
                      Content="{Binding $parent[ListBox].((vm:VerifactuPageViewModel)DataContext).L[VerifactuCorrect]}"
                      IsVisible="{Binding CanCorrect}"
                      Command="{Binding $parent[ListBox].((vm:VerifactuPageViewModel)DataContext).CorrectCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
