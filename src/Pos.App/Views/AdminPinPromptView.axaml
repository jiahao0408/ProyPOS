<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             xmlns:v="using:Pos.App.Views"
             x:Class="Pos.App.Views.AdminPinPromptView"
             x:DataType="vm:AdminPinPromptViewModel">
  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="12" Padding="32"
          HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 32 0 #60000000">
    <StackPanel Width="340">
      <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"
                 Text="{Binding L[AdminPinTitle]}" />
      <v:PinPadView DataContext="{Binding PinEntry}" />
      <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Content="{Binding L[Cancel]}" Command="{Binding CancelCommand}" />
      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
