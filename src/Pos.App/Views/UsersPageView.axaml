<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             x:Class="Pos.App.Views.UsersPageView"
             x:DataType="vm:UsersPageViewModel">
  <Grid ColumnDefinitions="*,24,420">
    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="title" Text="{Binding L[NavUsers]}" />
        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Top" Content="{Binding L[NewUser]}" Command="{Binding NewCommand}" />
      </Grid>
      <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedRow}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:UserRow">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Role}" FontSize="15" Opacity="0.7" VerticalAlignment="Center" />
              <TextBlock Text="{Binding $parent[ListBox].((vm:UsersPageViewModel)DataContext).L[Inactive]}"
                         IsVisible="{Binding !IsActive}" Foreground="{StaticResource ErrorBrush}" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding $parent[ListBox].((vm:UsersPageViewModel)DataContext).L[Locked]}"
                         IsVisible="{Binding IsLocked}" Foreground="{StaticResource ErrorBrush}" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Classes="label" Text="{Binding L[Name]}" />
      <TextBox Text="{Binding Name}" />

      <TextBlock Classes="label" Text="{Binding L[Role]}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RoleOption">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Classes="label" Text="{Binding PinLabel}" />
      <TextBox Text="{Binding Pin}" PasswordChar="●" MaxLength="4" />

      <CheckBox Margin="0,12,0,0" Content="{Binding L[Active]}" IsChecked="{Binding IsActive}" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
        <Button Classes="primary" Content="{Binding L[Save]}" Command="{Binding SaveCommand}" />
        <Button Content="{Binding L[Unlock]}" Command="{Binding UnlockCommand}" IsVisible="{Binding IsLocked}" />
      </StackPanel>

      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
