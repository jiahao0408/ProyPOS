<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             x:Class="Pos.App.Views.VariantPickerView"
             x:DataType="vm:VariantPickerViewModel">
  <!-- BAZ-05: elegir la variante -->
  <Border Classes="dialog" Width="640">
    <StackPanel>
      <TextBlock Text="{Binding L[ChooseVariantTitle]}" FontSize="15" Opacity="0.75" />
      <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

      <ScrollViewer MaxHeight="420">
        <ItemsControl ItemsSource="{Binding Variants}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VariantOption">
              <Button Classes="tile" Focusable="False" Height="88"
                      Command="{Binding $parent[ItemsControl].((vm:VariantPickerViewModel)DataContext).PickCommand}"
                      CommandParameter="{Binding}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Price}" TextAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Button Margin="0,16,0,0" Content="{Binding L[Cancel]}" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Border>
</UserControl>
