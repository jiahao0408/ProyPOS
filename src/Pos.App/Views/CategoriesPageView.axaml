<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             xmlns:domain="using:Pos.Core.Domain"
             x:Class="Pos.App.Views.CategoriesPageView"
             x:DataType="vm:CategoriesPageViewModel">
  <Grid ColumnDefinitions="*,24,420">
    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="title" Text="{Binding L[NavCategories]}" />
        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Top" Content="{Binding L[NewCategory]}" Command="{Binding NewCommand}" />
      </Grid>
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="domain:Category">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding SortOrder}" Width="32" Opacity="0.6" FontSize="17" />
              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Color}" Opacity="0.6" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding $parent[ListBox].((vm:CategoriesPageViewModel)DataContext).L[GenericSaleShort]}"
                         IsVisible="{Binding AllowsGenericSale}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Classes="label" Text="{Binding L[Name]}" />
      <TextBox Text="{Binding Name}" />

      <TextBlock Classes="label" Text="{Binding L[SortOrder]}" />
      <TextBox Text="{Binding SortOrderText}" />

      <TextBlock Classes="label" Text="{Binding L[Color]}" />
      <TextBox Text="{Binding Color}" Watermark="#FF8800" />

      <CheckBox Margin="0,12,0,0" Content="{Binding L[AllowsGenericSale]}" IsChecked="{Binding AllowsGenericSale}" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
        <Button Classes="primary" Content="{Binding L[Save]}" Command="{Binding SaveCommand}" />
        <Button Classes.danger="{Binding IsDeletePending}" Content="{Binding L[Delete]}"
                Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
      </StackPanel>

      <Border Classes="message" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" />
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
