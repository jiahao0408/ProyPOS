<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.App.ViewModels"
             xmlns:domain="using:Pos.Core.Domain"
             x:Class="Pos.App.Views.ReceiptsPageView"
             x:DataType="vm:ReceiptsPageViewModel">
  <!-- INV-03: entradas de mercancía; BAZ-04: por cajas -->
  <Grid>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding L[NavReceipts]}" />

      <!-- Proveedor y albarán -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,12,*,12,220" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Classes="label" Text="{Binding L[Supplier]}" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="domain:Supplier">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="label" Text="{Binding L[NewSupplier]}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewSupplierName}" />
            <Button Grid.Column="1" Margin="6,0,0,0" Content="+" Command="{Binding AddSupplierCommand}" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Classes="label" Text="{Binding L[DeliveryNote]}" />
          <TextBox Text="{Binding Reference}" />
        </StackPanel>
      </Grid>

      <!-- Escanear o buscar productos -->
      <TextBox DockPanel.Dock="Top" Watermark="{Binding L[SaleSearchHint]}" Text="{Binding SearchText}" FontSize="20">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SearchResults}" Margin="0,4,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="domain:Product">
            <Button Margin="0,0,6,6" Content="{Binding Name}"
                    Command="{Binding $parent[ItemsControl].((vm:ReceiptsPageViewModel)DataContext).AddProductCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Classes="primary" Content="{Binding L[SaveReceipt]}" Command="{Binding SaveCommand}" />
        <Border Classes="message" Margin="0" Classes.error="{Binding MessageIsError}" IsVisible="{Binding HasMessage}">
          <TextBlock Text="{Binding Message}" />
        </Border>
      </StackPanel>

      <!-- Líneas -->
      <ScrollViewer Margin="0,8,0,0">
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReceiptLineViewModel">
              <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid ColumnDefinitions="*,110,Auto,150,Auto,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UnitsText}" FontSize="13" Opacity="0.7" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding QuantityText}" Margin="8,0" />
                  <CheckBox Grid.Column="2" IsChecked="{Binding InBoxes}" IsVisible="{Binding CanUseBoxes}"
                            Content="{Binding BoxInfo}" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="3">
                    <TextBlock Text="{Binding CostLabel}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding CostText}" />
                  </StackPanel>
                  <Button Grid.Column="5" Content="✕" Margin="8,0,0,0"
                          Command="{Binding $parent[ItemsControl].((vm:ReceiptsPageViewModel)DataContext).RemoveLineCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <Border IsVisible="{Binding IsDialogOpen}" Background="#80000000">
      <ContentControl Content="{Binding Dialog}" />
    </Border>
  </Grid>
</UserControl>
